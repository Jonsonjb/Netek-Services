rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global catch-all denial for all other collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'admin@jonsonjb.com';
    }

    // 1. Pedidos Plantas
    match /pedidos_plantas/{pedidoId} {
      allow create: if true; // Anyone can submit a calculation request
      allow read, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if false; // Pedidos are read-only after submission
    }

    // 2. Vagas Trabalho
    match /vagas_trabalho/{vagaId} {
      allow read: if true; // Public feed is readable by everyone
      allow create: if true; // Anyone can publish a work offer
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // 3. Pedidos CV
    match /pedidos_cv/{pedidoId} {
      allow create: if true; // Anyone can submit CV request data
      allow read, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if false;
    }

    // 4. Pedidos Cartas
    match /pedidos_cartas/{pedidoId} {
      allow create: if true; // Anyone can submit Letter request data
      allow read, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if false;
    }

    // 5. Pedidos Contratos
    match /pedidos_contratos/{pedidoId} {
      allow create: if true; // Anyone can submit Contract request data
      allow read, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if false;
    }

    // 6. Imoveis
    match /imoveis/{imovelId} {
      allow read: if true; // Anyone can view listed houses or land plots
      allow create: if true; // Anyone can submit classified listings
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // 7. Users Profiles (PII Protected)
    match /users/{userId} {
      allow read, write: if isAdmin() || (isSignedIn() && userId == request.auth.uid);
    }
  }
}
